@page "/Account/ChangePassword"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Identity.Server.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

<div class="page-center">
    <div>
        <div class="brand">
            <div class="brand-mark">E</div>
            <div class="brand-name">EXAM PLATFORM</div>
        </div>

        <div class="auth-card">
            <h1>Đổi mật khẩu</h1>
            <p class="subtitle">Đổi mật khẩu đăng nhập của bạn.</p>

            @if (successMessage is not null)
            {
                <div class="alert-success">
                    <span>@successMessage</span>
                </div>
                <a href="/">Quay lại Exam Platform</a>
            }
            else
            {
                @if (errorMessage is not null)
                {
                    <div class="alert-error">
                        <span>⚠</span>
                        <span>@errorMessage</span>
                    </div>
                }

                <EditForm Model="Input" FormName="change-password" OnValidSubmit="ChangePasswordAsync" method="post" data-enhance="false">
                    <DataAnnotationsValidator />

                    <div class="field">
                        <label for="oldPassword">Mật khẩu hiện tại</label>
                        <InputText id="oldPassword" type="password" @bind-Value="Input.OldPassword" autocomplete="current-password" autofocus />
                        <ValidationMessage For="() => Input.OldPassword" class="validation-message" />
                    </div>

                    <div class="field">
                        <label for="newPassword">Mật khẩu mới</label>
                        <InputText id="newPassword" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" />
                        <ValidationMessage For="() => Input.NewPassword" class="validation-message" />
                    </div>

                    <div class="field">
                        <label for="confirmPassword">Xác nhận mật khẩu mới</label>
                        <InputText id="confirmPassword" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
                        <ValidationMessage For="() => Input.ConfirmPassword" class="validation-message" />
                    </div>

                    <button type="submit">Đổi mật khẩu</button>
                </EditForm>
            }
        </div>

        <p class="footer-note">Identity Server — Exam Platform</p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private string? errorMessage;
    private string? successMessage;

    private async Task ChangePasswordAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            errorMessage = "Không xác định được tài khoản, hãy đăng nhập lại.";
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        // Đổi mật khẩu làm SecurityStamp đổi theo - refresh lại cookie đang có để không bị đăng xuất
        // ngay sau khi vừa đổi thành công.
        await SignInManager.RefreshSignInAsync(user);
        successMessage = "Đã đổi mật khẩu thành công.";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bắt buộc nhập mật khẩu hiện tại.")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Bắt buộc nhập mật khẩu mới.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Bắt buộc xác nhận mật khẩu mới.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Xác nhận mật khẩu không khớp.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
