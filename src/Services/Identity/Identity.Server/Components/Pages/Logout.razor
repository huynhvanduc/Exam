@page "/Account/Logout"
@using IdentityServer4.Services
@using Identity.Server.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject IIdentityServerInteractionService Interaction
@inject NavigationManager Navigation

<div class="page-center">
    <div>
        <div class="brand">
            <div class="brand-mark">E</div>
            <div class="brand-name">EXAM PLATFORM</div>
        </div>

        <div class="auth-card">
            <h1>Đang đăng xuất...</h1>
            <p class="subtitle">Vui lòng đợi trong giây lát.</p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "logoutId")]
    private string? LogoutId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await SignInManager.SignOutAsync();

        var logoutRequest = await Interaction.GetLogoutContextAsync(LogoutId);

        Navigation.NavigateTo(string.IsNullOrEmpty(logoutRequest.PostLogoutRedirectUri) ? "/" : logoutRequest.PostLogoutRedirectUri, forceLoad: true);
    }
}
