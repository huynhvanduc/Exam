<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập — Exam Platform</title>
    <base href="@(HttpContext.Request.PathBase)/" />
    <style>
        :root {
            --bg: #f1f3f8;
            --card-bg: #ffffff;
            --text: #1a1d29;
            --text-muted: #6b7280;
            --border: #e2e5ea;
            --accent: #4f46e5;
            --accent-hover: #4338ca;
            --error-bg: #fef2f2;
            --error-text: #b91c1c;
            --error-border: #fecaca;
            --shadow: 0 8px 30px rgba(20, 20, 40, .08), 0 1px 2px rgba(20, 20, 40, .04);
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: #14161f;
                --card-bg: #1c1f2b;
                --text: #f1f2f6;
                --text-muted: #9296a6;
                --border: #2c2f3d;
                --accent: #6366f1;
                --accent-hover: #7c7ff2;
                --error-bg: #2c1618;
                --error-text: #fca5a5;
                --error-border: #5b2326;
                --shadow: 0 8px 30px rgba(0, 0, 0, .35);
            }
        }

        * { box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            min-height: 100vh;
        }

        .page-center {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .brand {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 24px;
        }

        .brand-mark {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--accent), #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 18px;
            margin-bottom: 12px;
        }

        .brand-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-muted);
            letter-spacing: .02em;
        }

        .auth-card {
            width: 100%;
            max-width: 380px;
            background: var(--card-bg);
            padding: 32px;
            border-radius: 12px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
        }

        .auth-card h1 {
            font-size: 20px;
            font-weight: 700;
            margin: 0 0 4px;
        }

        .auth-card .subtitle {
            font-size: 14px;
            color: var(--text-muted);
            margin: 0 0 24px;
        }

        .auth-card label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text);
        }

        .auth-card input[type=text],
        .auth-card input[type=password] {
            width: 100%;
            padding: 10px 12px;
            margin-bottom: 4px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--bg);
            color: var(--text);
            font-size: 14px;
            transition: border-color .15s, box-shadow .15s;
        }

        .auth-card input[type=text]:focus,
        .auth-card input[type=password]:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
        }

        .field { margin-bottom: 18px; }

        .remember-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: -6px 0 20px;
            font-size: 13px;
            color: var(--text-muted);
        }

        .remember-row input { margin: 0; }

        .auth-card button {
            width: 100%;
            padding: 11px;
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: background .15s;
        }

        .auth-card button:hover { background: var(--accent-hover); }
        .auth-card button:active { transform: translateY(1px); }

        .validation-message {
            display: block;
            color: var(--error-text);
            font-size: 12px;
            margin: 0 0 14px;
        }

        .alert-error {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            background: var(--error-bg);
            color: var(--error-text);
            border: 1px solid var(--error-border);
            padding: 10px 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 13px;
            line-height: 1.4;
        }

        .footer-note {
            text-align: center;
            margin-top: 20px;
            font-size: 12px;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
}
