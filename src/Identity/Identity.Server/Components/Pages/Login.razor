@page "/Account/Login"
@using System.ComponentModel.DataAnnotations
@using IdentityServer4.Services
@using Identity.Server.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject IIdentityServerInteractionService Interaction
@inject NavigationManager Navigation

<div class="page-center">
    <div>
        <div class="brand">
            <div class="brand-mark">E</div>
            <div class="brand-name">EXAM PLATFORM</div>
        </div>

        <div class="auth-card">
            <h1>Đăng nhập</h1>
            <p class="subtitle">Đăng nhập để tiếp tục.</p>

            @if (errorMessage is not null)
            {
                <div class="alert-error">
                    <span>⚠</span>
                    <span>@errorMessage</span>
                </div>
            }

            <EditForm Model="Input" FormName="login" OnValidSubmit="LoginUser" method="post" data-enhance="false">
                <DataAnnotationsValidator />

                <div class="field">
                    <label for="username">Tên đăng nhập</label>
                    <InputText id="username" @bind-Value="Input.Username" autocomplete="username" autofocus />
                    <ValidationMessage For="() => Input.Username" class="validation-message" />
                </div>

                <div class="field">
                    <label for="password">Mật khẩu</label>
                    <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
                    <ValidationMessage For="() => Input.Password" class="validation-message" />
                </div>

                <label class="remember-row">
                    <InputCheckbox @bind-Value="Input.RememberMe" id="rememberMe" />
                    <span>Ghi nhớ đăng nhập</span>
                </label>

                <button type="submit">Đăng nhập</button>
            </EditForm>
        </div>

        <p class="footer-note">Identity Server — Exam Platform</p>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? errorMessage;

    private async Task LoginUser()
    {
        // Chỉ chấp nhận ReturnUrl là 1 yêu cầu authorize hợp lệ do chính IdentityServer sinh ra,
        // tránh open-redirect nếu ReturnUrl bị chỉnh sửa thủ công.
        if (!string.IsNullOrEmpty(ReturnUrl) && await Interaction.GetAuthorizationContextAsync(ReturnUrl) is null)
        {
            errorMessage = "Yêu cầu đăng nhập không hợp lệ hoặc đã hết hạn.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(Input.Username, Input.Password, Input.RememberMe, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Navigation.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl, forceLoad: true);
            return;
        }

        errorMessage = result.IsLockedOut
            ? "Tài khoản đã bị khoá do đăng nhập sai quá nhiều lần. Vui lòng thử lại sau 15 phút."
            : "Tên đăng nhập hoặc mật khẩu không đúng.";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bắt buộc nhập tên đăng nhập.")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Bắt buộc nhập mật khẩu.")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
