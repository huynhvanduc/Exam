<span class="cb @(Value ? CheckedClass : "") @(Changed ? "changed" : "") @Class"
      style="@(Disabled ? "opacity:.5;cursor:not-allowed;" : "")"
      title="@Title"
      @onclick="HandleClick"></span>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string CheckedClass { get; set; } = "checked";
    [Parameter] public bool Changed { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }

    private Task HandleClick() => Disabled ? Task.CompletedTask : OnClick.InvokeAsync();
}
