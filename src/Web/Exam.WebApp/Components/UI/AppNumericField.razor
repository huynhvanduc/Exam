@typeparam TValue
@implements IAppFormField
@implements IDisposable

<div class="field @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@id">@Label@(Required ? " *" : "")</label>
    }
    <input id="@id" type="number" step="@Step" min="@Min" max="@Max" disabled="@Disabled" placeholder="@Placeholder"
           value="@Value" @oninput="OnInput" />
    @if (!string.IsNullOrEmpty(computedError ?? ErrorText))
    {
        <div class="error">@(computedError ?? ErrorText)</div>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <div class="hint">@Hint</div>
    }
</div>

@code {
    private readonly string id = $"f{Guid.NewGuid():N}";
    private string? computedError;

    [CascadingParameter] private AppForm? Form { get; set; }

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string? RequiredError { get; set; }
    [Parameter] public string? Step { get; set; }
    [Parameter] public string? Min { get; set; }
    [Parameter] public string? Max { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    protected override void OnInitialized() => Form?.Register(this);

    public bool Validate()
    {
        computedError = Required && Value == null ? RequiredError ?? "Bắt buộc nhập." : null;
        StateHasChanged();
        return computedError == null;
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        TValue? parsed = default;
        if (!string.IsNullOrEmpty(raw))
        {
            try { parsed = (TValue)Convert.ChangeType(raw, Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue)); }
            catch (Exception ex) when (ex is FormatException or OverflowException or InvalidCastException) { }
        }
        Value = parsed;
        if (computedError != null)
            Validate();
        await ValueChanged.InvokeAsync(Value);
    }

    void IDisposable.Dispose() => Form?.Unregister(this);
}
