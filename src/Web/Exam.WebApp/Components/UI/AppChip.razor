<span class="chip @VariantClass @Class">@ChildContent</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public AppChipVariant Variant { get; set; } = AppChipVariant.Default;
    [Parameter] public string? Class { get; set; }

    private string VariantClass => Variant switch
    {
        AppChipVariant.Success => "success",
        AppChipVariant.Danger => "danger",
        AppChipVariant.Info => "info",
        _ => ""
    };
}
