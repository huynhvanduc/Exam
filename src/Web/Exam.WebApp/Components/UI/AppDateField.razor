@implements IAppFormField
@implements IDisposable

<div class="field @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@id">@Label@(Required ? " *" : "")</label>
    }
    <input id="@id" type="date" disabled="@Disabled" value="@(Value?.ToString("yyyy-MM-dd"))" @oninput="OnInput" />
    @if (!string.IsNullOrEmpty(computedError ?? ErrorText))
    {
        <div class="error">@(computedError ?? ErrorText)</div>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <div class="hint">@Hint</div>
    }
</div>

@code {
    private readonly string id = $"f{Guid.NewGuid():N}";
    private string? computedError;

    [CascadingParameter] private AppForm? Form { get; set; }

    // Value ở đây là kiểu DateTime?, không phải string, nên Razor luôn parse giá trị gán là biểu thức
    // C# dù có hay không có dấu "@" - khác với AppTextField.Value (string?), nơi thiếu "@" sẽ bị hiểu
    // nhầm thành literal string. Xem AppTextField.razor để biết chi tiết.
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string? RequiredError { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    protected override void OnInitialized() => Form?.Register(this);

    public bool Validate()
    {
        computedError = Required && Value == null ? RequiredError ?? "Bắt buộc chọn ngày." : null;
        StateHasChanged();
        return computedError == null;
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        Value = string.IsNullOrEmpty(raw) ? null : DateTime.Parse(raw);
        if (computedError != null)
            Validate();
        await ValueChanged.InvokeAsync(Value);
    }

    void IDisposable.Dispose() => Form?.Unregister(this);
}
