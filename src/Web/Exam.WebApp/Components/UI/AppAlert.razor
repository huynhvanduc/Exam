<div class="inline-alert @SeverityClass @Class">@ChildContent</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public AppAlertSeverity Severity { get; set; } = AppAlertSeverity.Info;
    [Parameter] public string? Class { get; set; }

    private string SeverityClass => Severity switch
    {
        AppAlertSeverity.Success => "success",
        AppAlertSeverity.Warning => "warning",
        AppAlertSeverity.Danger => "danger",
        _ => "info"
    };
}
