@page "/admin/audit-log"
@attribute [Authorize(Roles = "Admin")]
@inherits AdminPageBase

<PageTitle>Nhật ký hoạt động</PageTitle>

<AdminPageHeader Title="Nhật ký thay đổi quyền / role" Subtitle="Ghi lại toàn bộ thao tác khoá/mở khoá tài khoản và đổi vai trò do Admin thực hiện." />

<AppCard>
    <div class="audit-filters">
        <AppTextField Value="@actorFilter" ValueChanged="v => actorFilter = v" Placeholder="Người thực hiện…" />
        <AppSelect TValue="string" @bind-Value="actionFilter">
            <option value="">Tất cả hành động</option>
            <option value="User.ActiveStatusChanged">Khoá / Mở khoá tài khoản</option>
            <option value="User.RoleChanged">Đổi vai trò</option>
            <option value="Role.PermissionsChanged">Đổi quyền theo Role</option>
        </AppSelect>
        <input type="date" @bind="fromFilter" />
        <input type="date" @bind="toFilter" />
        <AppButton OnClick="ApplyFiltersAsync">Áp dụng</AppButton>
        <AppButton OnClick="ResetFiltersAsync">Xoá lọc</AppButton>
        <span class="spacer"></span>
        <span class="result-count">@resultCount sự kiện</span>
    </div>

    <AppTable TItem="AuditLogEntryDto" @ref="table" ServerData="LoadServerData" ColumnCount="5"
              EmptyText="Không có sự kiện nào khớp bộ lọc.">
        <HeaderContent>
            <th>Thời gian</th><th>Người thực hiện</th><th>Hành động</th><th>Đối tượng</th><th>Chi tiết</th>
        </HeaderContent>
        <RowTemplate Context="entry">
            <tr>
                <td>@entry.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>@entry.ActorUserId</td>
                <td>@ActionLabel(entry.Action)</td>
                <td>@entry.TargetId</td>
                <td>
                    <AppTooltip Text="@entry.Description">
                        <span style="display:inline-block;max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@entry.Description</span>
                    </AppTooltip>
                </td>
            </tr>
        </RowTemplate>
    </AppTable>
</AppCard>
