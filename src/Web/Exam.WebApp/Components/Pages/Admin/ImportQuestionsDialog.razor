@inherits FormDialogBase
@using Microsoft.AspNetCore.Components.Forms

<p class="page-sub">
    Chọn file Excel (.xlsx) theo mẫu: Môn học, Mức độ, Loại câu hỏi, Nội dung câu hỏi, Đáp án A-D, Đáp án đúng, Giải thích.
    Dùng nút "Export Excel" ở trang danh sách để lấy file mẫu đúng định dạng.
</p>

<InputFile OnChange="OnFileSelectedAsync" accept=".xlsx" />

@if (isBusy && previewResult == null)
{
    <AppSpinner />
}

@if (previewResult != null)
{
    <p style="margin:12px 0;">
        Tổng số dòng: <b>@previewResult.TotalRows</b> — Hợp lệ: <b>@previewResult.SuccessCount</b> — Lỗi: <b>@previewResult.Errors.Count</b>
    </p>

    @if (previewResult.ValidRows.Count > 0)
    {
        <div style="font-size:13px;font-weight:700;margin-bottom:6px;">Câu hỏi sẽ được thêm:</div>
        <div style="max-height:260px;overflow-y:auto;">
            <table class="data">
                <thead><tr><th>Dòng</th><th>Môn học</th><th>Nội dung</th><th>Loại</th></tr></thead>
                <tbody>
                    @foreach (var row in previewResult.ValidRows.Take(MaxPreviewRows))
                    {
                        <tr>
                            <td>@row.RowNumber</td>
                            <td>@row.CategoryName</td>
                            <td>@TextUtils.Truncate(row.Content, 90)</td>
                            <td>@row.QuestionType</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (previewResult.ValidRows.Count > MaxPreviewRows)
        {
            <p class="page-sub">… và @(previewResult.ValidRows.Count - MaxPreviewRows) dòng hợp lệ khác.</p>
        }
    }

    @if (previewResult.Errors.Count > 0)
    {
        <AppAlert Severity="AppAlertSeverity.Warning">
            @previewResult.Errors.Count dòng lỗi sẽ bị BỎ QUA khi xác nhận nhập, các dòng còn lại vẫn được thêm bình thường.
        </AppAlert>
        <div style="max-height:200px;overflow-y:auto;">
            <table class="data">
                <thead><tr><th>Dòng</th><th>Nội dung</th><th>Lỗi</th></tr></thead>
                <tbody>
                    @foreach (var error in previewResult.Errors.Take(MaxPreviewRows))
                    {
                        <tr>
                            <td>@error.RowNumber</td>
                            <td>@TextUtils.Truncate(error.ContentExcerpt, 90)</td>
                            <td>@error.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (previewResult.Errors.Count > MaxPreviewRows)
        {
            <p class="page-sub">… và @(previewResult.Errors.Count - MaxPreviewRows) lỗi khác.</p>
        }
    }
}

<div class="modal-actions">
    <AppButton OnClick="Cancel">Huỷ</AppButton>
    @if (previewResult != null)
    {
        <AppButton Variant="AppButtonVariant.Primary" Disabled="previewResult.SuccessCount == 0 || isBusy" OnClick="ConfirmAsync">
            Xác nhận nhập (@previewResult.SuccessCount câu)
        </AppButton>
    }
</div>
