@inherits FormDialogBase

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudTextField T="string" Label="Tên lớp" @bind-Value="name" Required="true" RequiredError="Bắt buộc nhập tên lớp." />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Huỷ</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Lưu</MudButton>
    </DialogActions>
</MudDialog>
