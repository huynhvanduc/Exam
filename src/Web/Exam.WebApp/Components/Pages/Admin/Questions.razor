@page "/admin/questions"
@attribute [Authorize(Roles = "Instructor,Admin")]
@inherits AdminPageBase

<PageTitle>Ngân hàng câu hỏi</PageTitle>

<AdminPageHeader Title="Ngân hàng câu hỏi">
    <CategorySelector Categories="categories" Value="@selectedCategoryId" ValueChanged="OnCategoryChangedAsync" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               Class="mb-4 ml-4" OnClick="OpenCreateDialog" Disabled="string.IsNullOrEmpty(selectedCategoryId)">
        Thêm câu hỏi
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile"
               Class="mb-4 ml-2" OnClick="OpenImportDialogAsync">
        Import Excel
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
               Class="mb-4 ml-2" OnClick="ExportAsync" Disabled="string.IsNullOrEmpty(selectedCategoryId)">
        Export Excel
    </MudButton>
</AdminPageHeader>

@if (categories == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (string.IsNullOrEmpty(selectedCategoryId))
{
    <MudAlert Severity="Severity.Info">Chọn môn học để xem danh sách câu hỏi.</MudAlert>
}
else
{
    <MudStack Row="true" Spacing="4" Class="mb-4" Style="max-width: 900px;">
        <MudTextField T="string" Label="Tìm theo nội dung" Value="keyword" ValueChanged="OnKeywordChangedAsync"
                      Immediate="true" DebounceInterval="400" Clearable="true" />
        <MudSelect T="Level?" Label="Mức độ" Value="levelFilter" ValueChanged="OnLevelChangedAsync" Clearable="true">
            <MudSelectItem T="Level?" Value="Level.Easy">Dễ</MudSelectItem>
            <MudSelectItem T="Level?" Value="Level.Medium">Trung bình</MudSelectItem>
            <MudSelectItem T="Level?" Value="Level.Difficult">Khó</MudSelectItem>
        </MudSelect>
        <MudSelect T="QuestionType?" Label="Loại câu hỏi" Value="questionTypeFilter" ValueChanged="OnQuestionTypeChangedAsync" Clearable="true">
            <MudSelectItem T="QuestionType?" Value="QuestionType.SingleSelection">Một đáp án đúng</MudSelectItem>
            <MudSelectItem T="QuestionType?" Value="QuestionType.MultipleSelection">Nhiều đáp án đúng</MudSelectItem>
        </MudSelect>
    </MudStack>

    <MudTable T="QuestionDto" @ref="table" ServerData="LoadServerData" Hover="true">
        <HeaderContent>
            <MudTh>Nội dung</MudTh>
            <MudTh>Loại</MudTh>
            <MudTh>Mức độ</MudTh>
            <MudTh>Điểm</MudTh>
            <MudTh>Đáp án</MudTh>
            <MudTh>Hành động</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nội dung">@Truncate(context.Content)</MudTd>
            <MudTd DataLabel="Loại">@QuestionTypeLabel(context.QuestionType)</MudTd>
            <MudTd DataLabel="Mức độ">@context.Level.ToLabel()</MudTd>
            <MudTd DataLabel="Điểm">@context.Points</MudTd>
            <MudTd DataLabel="Đáp án">@context.Answers.Count(a => a.IsCorrect)/@context.Answers.Count đúng</MudTd>
            <MudTd DataLabel="Hành động">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEditDialog(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Chưa có câu hỏi nào trong môn học này.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}
