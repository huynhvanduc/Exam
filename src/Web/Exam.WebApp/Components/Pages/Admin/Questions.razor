@page "/admin/questions"
@attribute [Authorize(Roles = "Instructor,Admin")]
@inherits AdminPageBase

<PageTitle>Ngân hàng câu hỏi</PageTitle>

<div class="toolbar">
    <h1 class="page-title" style="margin:0;">Ngân hàng câu hỏi</h1>
    <CategorySelector Categories="categories" Value="@selectedCategoryId" ValueChanged="OnCategoryChangedAsync" />
    <span class="spacer"></span>
    <AppButton OnClick="OpenImportDialogAsync">Import Excel</AppButton>
    <AppButton Disabled="string.IsNullOrEmpty(selectedCategoryId)" OnClick="ExportAsync">Export Excel</AppButton>
    <AppButton Variant="AppButtonVariant.Primary" Disabled="string.IsNullOrEmpty(selectedCategoryId)" OnClick="OpenCreateDialog">+ Thêm câu hỏi</AppButton>
</div>

@if (categories == null)
{
    <AppSpinner />
}
else if (string.IsNullOrEmpty(selectedCategoryId))
{
    <AppAlert Severity="AppAlertSeverity.Info">Chọn môn học để xem danh sách câu hỏi.</AppAlert>
}
else
{
    <div class="filters">
        <AppTextField Value="@keyword" ValueChanged="OnKeywordChangedAsync" Placeholder="Tìm theo nội dung…" />
        <AppSelect TValue="Level?" Value="levelFilter" ValueChanged="OnLevelChangedAsync">
            <option value="">Mức độ</option>
            <option value="@Level.Easy">Dễ</option>
            <option value="@Level.Medium">Trung bình</option>
            <option value="@Level.Difficult">Khó</option>
        </AppSelect>
        <AppSelect TValue="QuestionType?" Value="questionTypeFilter" ValueChanged="OnQuestionTypeChangedAsync">
            <option value="">Loại câu hỏi</option>
            <option value="@QuestionType.SingleSelection">Một đáp án</option>
            <option value="@QuestionType.MultipleSelection">Nhiều đáp án</option>
        </AppSelect>
    </div>

    @if (selectedIds.Count > 0)
    {
        <div class="bulkbar">
            <span>Đã chọn @selectedIds.Count câu hỏi</span>
            <span class="spacer"></span>
            <AppButton Variant="AppButtonVariant.OutlineAccent" OnClick="OpenMoveModal">↔ Chuyển sang môn học khác</AppButton>
            <AppButton Variant="AppButtonVariant.Danger" OnClick="BulkDeleteAsync">Xoá</AppButton>
        </div>
    }

    <AppCard>
        <AppTable TItem="QuestionDto" @ref="table" ServerData="LoadServerData" ColumnCount="7"
                  EmptyText="Chưa có câu hỏi nào trong môn học này.">
            <HeaderContent>
                <th style="width:32px;"></th><th>Nội dung</th><th>Loại</th><th>Mức độ</th><th>Đáp án</th><th></th>
            </HeaderContent>
            <RowTemplate Context="question">
                <tr class="@(IsSelected(question) ? "selected" : "")">
                    <td>
                        <AppCb Value="IsSelected(question)" OnClick="() => ToggleSelect(question)"
                               Disabled="!CanManage(currentUser, question.OwnerUserId)"
                               Title="@(CanManage(currentUser, question.OwnerUserId) ? null : "Không phải câu hỏi của bạn")" />
                    </td>
                    <td>@TextUtils.Truncate(question.Content, 80)</td>
                    <td>@QuestionTypeLabel(question.QuestionType)</td>
                    <td>@question.Level.ToLabel()</td>
                    <td>@question.Answers.Count(a => a.IsCorrect)/@question.Answers.Count đúng</td>
                    <td>
                        <AppButton Disabled="!CanManage(currentUser, question.OwnerUserId)" OnClick="() => OpenEditDialog(question)">✎</AppButton>
                        <AppButton Variant="AppButtonVariant.Danger" Disabled="!CanManage(currentUser, question.OwnerUserId)" OnClick="() => DeleteAsync(question)">🗑</AppButton>
                    </td>
                </tr>
            </RowTemplate>
        </AppTable>
    </AppCard>
}

@if (showMoveModal)
{
    <div class="modal-overlay open">
        <div class="modal" style="max-width:420px;">
            <h2>Chuyển @selectedIds.Count câu hỏi sang môn học khác</h2>
            <div class="field">
                <label>Môn học đích</label>
                <AppSelect TValue="string" @bind-Value="moveTargetCategoryId">
                    @foreach (var c in categories!.Where(c => c.Id != selectedCategoryId))
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </AppSelect>
            </div>
            <div class="modal-actions">
                <AppButton OnClick="() => showMoveModal = false">Huỷ</AppButton>
                <AppButton Variant="AppButtonVariant.Primary" OnClick="ConfirmMoveAsync">Chuyển câu hỏi</AppButton>
            </div>
        </div>
    </div>
}
