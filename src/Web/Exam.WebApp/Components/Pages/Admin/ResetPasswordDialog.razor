@inherits FormDialogBase

@if (result == null)
{
    <p class="desc">Đặt lại mật khẩu cho <strong>@FullName</strong> (@Email)? Mật khẩu hiện tại của người này sẽ không còn dùng được nữa.</p>
    <div class="modal-actions">
        <AppButton OnClick="Cancel">Huỷ</AppButton>
        <AppButton Variant="AppButtonVariant.Primary" OnClick="Submit" Loading="isBusy">Đặt lại mật khẩu</AppButton>
    </div>
}
else
{
    <div class="alert-success">
        Đã đặt lại mật khẩu cho <strong>@FullName</strong>.
    </div>
    <div class="field">
        <label>Mật khẩu mới</label>
        <div class="password-copy-row">
            <input type="text" readonly value="@result.GeneratedPassword" />
            <AppButton OnClick="CopyPasswordAsync">@(copied ? "Đã sao chép" : "Sao chép")</AppButton>
        </div>
        <div class="hint">Mật khẩu chỉ hiển thị một lần, hãy sao chép và gửi cho người dùng qua kênh riêng (Zalo, gặp trực tiếp...) — hệ thống không lưu lại.</div>
    </div>
    <div class="modal-actions">
        <AppButton Variant="AppButtonVariant.Primary" OnClick="Done">Đóng</AppButton>
    </div>
}
