@page "/admin/categories"
@attribute [Authorize(Roles = "Instructor,Admin")]
@inherits AdminPageBase

<PageTitle>Quản lý môn học</PageTitle>

<div class="page-header">
    <h1 class="page-title" style="margin:0;">Quản lý môn học</h1>
    <span class="spacer"></span>
    <AppButton Variant="AppButtonVariant.Primary" OnClick="OpenCreateDialog">+ Thêm môn học</AppButton>
</div>

@if (categories == null)
{
    <AppSpinner />
}
else
{
    <AppCard>
        <AppTable TItem="CategoryDto" @ref="table" ServerData="LoadTableData" ColumnCount="3" InitialPageSize="6"
                  EmptyText="Chưa có môn học nào.">
            <HeaderContent>
                <th>Tên</th><th>Url Path</th><th>Hành động</th>
            </HeaderContent>
            <RowTemplate Context="category">
                <tr>
                    <td>@category.Name</td>
                    <td><code>@category.UrlPath</code></td>
                    <td>
                        <AppButton OnClick="() => OpenEditDialog(category)">✎ Sửa</AppButton>
                        <AppButton Variant="AppButtonVariant.Danger" OnClick="() => DeleteAsync(category)">🗑 Xoá</AppButton>
                    </td>
                </tr>
            </RowTemplate>
        </AppTable>
    </AppCard>
}
