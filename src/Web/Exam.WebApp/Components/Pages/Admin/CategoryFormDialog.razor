@inherits FormDialogBase

<AppForm @ref="form">
    <AppTextField Label="Tên môn học" Value="@name" ValueChanged="OnNameChanged" Required="true" RequiredError="Bắt buộc nhập tên." />
    <AppTextField Label="Url Path" Value="@urlPath" ValueChanged="OnUrlPathChanged" Required="true" RequiredError="Bắt buộc nhập url path."
                  Hint="Dùng cho đường dẫn, vd: cong-nghe-thong-tin" />
</AppForm>
<div class="modal-actions">
    <AppButton OnClick="Cancel">Huỷ</AppButton>
    <AppButton Variant="AppButtonVariant.Primary" OnClick="Submit">Lưu</AppButton>
</div>
