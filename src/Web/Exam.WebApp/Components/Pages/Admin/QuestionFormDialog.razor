@inherits FormDialogBase

<AppForm @ref="form">
    <AppTextField Label="Nội dung câu hỏi" @bind-Value="content" Lines="3" Required="true" RequiredError="Bắt buộc nhập nội dung." />

    <div class="field-row">
        <AppSelect TValue="QuestionType" Label="Loại câu hỏi" @bind-Value="questionType" @bind-Value:after="OnQuestionTypeChanged">
            <option value="@QuestionType.SingleSelection">Một đáp án đúng</option>
            <option value="@QuestionType.MultipleSelection">Nhiều đáp án đúng</option>
        </AppSelect>
        <AppSelect TValue="Level" Label="Mức độ" @bind-Value="level">
            <option value="@Level.Easy">Dễ</option>
            <option value="@Level.Medium">Trung bình</option>
            <option value="@Level.Difficult">Khó</option>
        </AppSelect>
    </div>

    <div style="max-width:160px;">
        <AppNumericField TValue="int" Label="Điểm" @bind-Value="points" Min="1" />
    </div>

    <AppTextField Label="Giải thích (không bắt buộc)" @bind-Value="explain" Lines="2" />
</AppForm>

<div style="font-size:13px;font-weight:700;margin:14px 0 6px;">Đáp án</div>
@if (answerError != null)
{
    <AppAlert Severity="AppAlertSeverity.Warning">@answerError</AppAlert>
}

@if (questionType == QuestionType.SingleSelection)
{
    <AppRadioGroup TValue="int" Value="singleCorrectIndex" ValueChanged="OnSingleCorrectChanged">
        @for (var i = 0; i < answers.Count; i++)
        {
            var index = i;
            <div class="answer-row">
                <AppRadio TValue="int" Value="index" />
                <input type="text" value="@answers[index].Content" placeholder="Nội dung đáp án"
                       @oninput="e => answers[index].Content = e.Value?.ToString() ?? string.Empty" />
                <button type="button" class="rm" @onclick="() => RemoveAnswer(index)">🗑</button>
            </div>
        }
    </AppRadioGroup>
}
else
{
    @for (var i = 0; i < answers.Count; i++)
    {
        var index = i;
        <div class="answer-row">
            <AppCheckbox Value="answers[index].IsCorrect" ValueChanged="v => answers[index].IsCorrect = v" />
            <input type="text" value="@answers[index].Content" placeholder="Nội dung đáp án"
                   @oninput="e => answers[index].Content = e.Value?.ToString() ?? string.Empty" />
            <button type="button" class="rm" @onclick="() => RemoveAnswer(index)">🗑</button>
        </div>
    }
}
<AppButton Type="button" OnClick="AddAnswer">+ Thêm đáp án</AppButton>

<div class="modal-actions">
    <AppButton OnClick="Cancel">Huỷ</AppButton>
    <AppButton Variant="AppButtonVariant.Primary" OnClick="Submit">Lưu</AppButton>
</div>
