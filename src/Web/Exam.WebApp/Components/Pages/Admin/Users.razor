@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inherits AdminPageBase

<PageTitle>Quản lý người dùng</PageTitle>

<AdminPageHeader Title="Quản lý người dùng" Subtitle="Đổi vai trò có hiệu lực ngay từ lần request tiếp theo của người dùng đó." />

<MudTable T="UserDto" @ref="table" ServerData="LoadServerData" Hover="true">
        <HeaderContent>
            <MudTh>Họ tên</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>External Id</MudTh>
            <MudTh>Vai trò</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Họ tên">@context.FirstName @context.LastName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="External Id">@context.ExternalId</MudTd>
            <MudTd DataLabel="Vai trò" Style="max-width: 220px;">
                <MudSelect T="UserRole" Value="context.Role" ValueChanged="role => ChangeRoleAsync(context, role)">
                    <MudSelectItem Value="UserRole.Student">Student</MudSelectItem>
                    <MudSelectItem Value="UserRole.Instructor">Instructor</MudSelectItem>
                    <MudSelectItem Value="UserRole.Admin">Admin</MudSelectItem>
                </MudSelect>
            </MudTd>
            <MudTd DataLabel="Trạng thái">
                @if (context.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Hoạt động</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Đã khóa</MudChip>
                }
            </MudTd>
            <MudTd>
                @if (context.IsActive)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Size="Size.Small"
                                   title="Khóa tài khoản" OnClick="() => ToggleActiveAsync(context, false)" />
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.LockOpen" Color="Color.Success" Size="Size.Small"
                                   title="Mở khóa tài khoản" OnClick="() => ToggleActiveAsync(context, true)" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Chưa có người dùng nào.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
