@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inherits AdminPageBase

<PageTitle>Quản lý người dùng</PageTitle>

<AdminPageHeader Title="Quản lý người dùng" Subtitle="Đổi vai trò có hiệu lực ngay từ lần request tiếp theo của người dùng đó." />

<AppCard>
    <div class="users-toolbar">
        <AppTextField Value="@searchFilter" ValueChanged="v => { searchFilter = v; return ApplyFiltersAsync(); }"
                      Class="search" Placeholder="Tìm theo tên hoặc email…" />
        <AppSelect TValue="UserRole?" Value="roleFilter" ValueChanged="v => { roleFilter = v; return ApplyFiltersAsync(); }" Class="role-select">
            <option value="">Tất cả vai trò</option>
            <option value="@UserRole.Student">Student</option>
            <option value="@UserRole.Instructor">Instructor</option>
            <option value="@UserRole.Admin">Admin</option>
        </AppSelect>
        <AppSelect TValue="bool?" Value="statusFilter" ValueChanged="v => { statusFilter = v; return ApplyFiltersAsync(); }" Class="role-select">
            <option value="">Tất cả trạng thái</option>
            <option value="true">Hoạt động</option>
            <option value="false">Đã khoá</option>
        </AppSelect>
        <span class="spacer"></span>
        <span class="result-count">@resultCount người dùng</span>
    </div>

    <AppTable TItem="UserDto" @ref="table" ServerData="LoadServerData" ColumnCount="5"
              EmptyText="Không tìm thấy người dùng phù hợp.">
        <HeaderContent>
            <th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th></th>
        </HeaderContent>
        <RowTemplate Context="user">
            <tr class="@(IsSelf(user) ? "row-self" : "")">
                <td>
                    @user.FirstName @user.LastName
                    @if (IsSelf(user))
                    {
                        <span class="self-tag">(Bạn)</span>
                    }
                </td>
                <td>@user.Email</td>
                <td>
                    @if (IsSelf(user))
                    {
                        <AppStatusPill Variant="AppStatusPillVariant.Info">@user.Role</AppStatusPill>
                    }
                    else
                    {
                        <AppSelect TValue="UserRole" Class="role-select" Value="user.Role" ValueChanged="role => ChangeRoleAsync(user, role)">
                            <option value="@UserRole.Student">Student</option>
                            <option value="@UserRole.Instructor">Instructor</option>
                            <option value="@UserRole.Admin">Admin</option>
                        </AppSelect>
                    }
                </td>
                <td>
                    @if (user.IsActive)
                    {
                        <AppStatusPill Variant="AppStatusPillVariant.Success">Hoạt động</AppStatusPill>
                    }
                    else
                    {
                        <AppStatusPill Variant="AppStatusPillVariant.Danger">Đã khoá</AppStatusPill>
                    }
                </td>
                <td>
                    <button class="lock-btn" disabled="@IsSelf(user)"
                            title="@(IsSelf(user) ? "Không thể tự khoá tài khoản của chính mình" : null)"
                            @onclick="() => ToggleActiveAsync(user, !user.IsActive)">
                        @(user.IsActive ? "🔒" : "🔓")
                    </button>
                </td>
            </tr>
        </RowTemplate>
    </AppTable>
</AppCard>
