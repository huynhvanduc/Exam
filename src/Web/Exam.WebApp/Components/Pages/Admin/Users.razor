@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inherits AdminPageBase

<PageTitle>Quản lý người dùng</PageTitle>

<AdminPageHeader Title="Quản lý người dùng" Subtitle="Đổi vai trò có hiệu lực ngay từ lần request tiếp theo của người dùng đó." />

<MudTable T="UserDto" @ref="table" ServerData="LoadServerData" Hover="true">
        <HeaderContent>
            <MudTh>Họ tên</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>External Id</MudTh>
            <MudTh>Vai trò</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Họ tên">@context.FirstName @context.LastName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="External Id">@context.ExternalId</MudTd>
            <MudTd DataLabel="Vai trò" Style="max-width: 220px;">
                <MudSelect T="UserRole" Value="context.Role" ValueChanged="role => ChangeRoleAsync(context, role)">
                    <MudSelectItem Value="UserRole.Student">Student</MudSelectItem>
                    <MudSelectItem Value="UserRole.Instructor">Instructor</MudSelectItem>
                    <MudSelectItem Value="UserRole.Admin">Admin</MudSelectItem>
                </MudSelect>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Chưa có người dùng nào.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
