@page "/admin/dashboard"
@attribute [Authorize(Roles = "Admin")]
@inherits AdminPageBase
@inject NavigationManager Navigation

<PageTitle>Tổng quan</PageTitle>

<AdminPageHeader Title="Tổng quan" />

@if (summary == null)
{
    <AppSpinner />
}
else
{
    <div class="tiles">
        <div class="tile" @onclick='() => Navigation.NavigateTo("/admin/categories")'>
            <span class="go">→</span>
            <div class="lbl">Môn học</div>
            <div class="val">@summary.TotalCategories</div>
        </div>
        <div class="tile" @onclick='() => Navigation.NavigateTo("/admin/questions")'>
            <span class="go">→</span>
            <div class="lbl">Câu hỏi</div>
            <div class="val">@summary.TotalQuestions</div>
        </div>
        <div class="tile" @onclick='() => Navigation.NavigateTo("/admin/exams")'>
            <span class="go">→</span>
            <div class="lbl">Đề thi</div>
            <div class="val">@summary.TotalExams <span style="font-size:12px;color:var(--ink-soft);font-weight:400;">· @summary.PublishedExams đã xuất bản</span></div>
        </div>
        <div class="tile" @onclick='() => Navigation.NavigateTo("/admin/users")'>
            <span class="go">→</span>
            <div class="lbl">Người dùng</div>
            <div class="val">@summary.TotalUsers</div>
        </div>
    </div>

    <AppCard>
        <div style="display:flex;align-items:center;margin-bottom:4px;">
            <b style="font-size:13.5px;">Hoạt động gần đây</b><span class="spacer"></span>
            <a class="see-all" href="/admin/audit-log">Xem tất cả trong Nhật ký →</a>
        </div>
        @if (summary.RecentActivity.Count == 0)
        {
            <div class="empty-state">Chưa có hoạt động nào được ghi nhận.</div>
        }
        else
        {
            @foreach (var entry in summary.RecentActivity)
            {
                <div class="activity-row">
                    <span><b>@entry.Timestamp.ToLocalTime().ToString("dd/MM HH:mm")</b> — @ActionLabel(entry.Action): @entry.Description</span>
                </div>
            }
        }
    </AppCard>
}
