@page "/"
@inject NavigationManager Navigation

<PageTitle>Exam Platform</PageTitle>

<h1 class="page-title">Exam Platform</h1>

<AuthorizeView>
    <Authorized>
        <p>Xin chào, @context.User.Identity?.Name.</p>
    </Authorized>
    <NotAuthorized>
        <p class="page-sub">Vui lòng đăng nhập để tiếp tục.</p>
        <AppButton Variant="AppButtonVariant.Primary" OnClick="GoToLogin">Đăng nhập</AppButton>
    </NotAuthorized>
</AuthorizeView>
