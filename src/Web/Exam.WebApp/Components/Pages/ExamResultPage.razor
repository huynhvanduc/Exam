@page "/exams/result/{AttemptId}"
@attribute [Authorize]
@inherits PageBase

<PageTitle>Kết quả thi</PageTitle>

@if (result == null)
{
    <AppSpinner />
}
else
{
    <AppCard Class="summary-card">
        <h1 class="page-title" style="margin-bottom:0;">@result.ExamTitle</h1>
        <div class="score">@result.TotalScore/@result.MaxPossibleScore điểm</div>
        @if (result.Passed.HasValue)
        {
            <AppChip Variant="@(result.Passed.Value ? AppChipVariant.Success : AppChipVariant.Danger)">
                @(result.Passed.Value ? "Đạt" : "Không đạt")
            </AppChip>
        }
        <div class="sub">Số câu đúng: @result.CorrectQuestionCount/@result.QuestionResults.Count</div>
    </AppCard>

    @foreach (var (question, index) in result.QuestionResults.Select((q, i) => (q, i)))
    {
        <AppCard Class="q-result">
            <div class="head">
                <span class="txt"><b>Câu @(index + 1).</b> @question.Content</span>
                <span class="icon @(question.Result ? "ok" : "no")">@(question.Result ? "✓" : "✕")</span>
            </div>
            <ul class="ans-list">
                @foreach (var answer in question.Answers)
                {
                    <li class="@AnswerCssClass(answer)">
                        @(answer.UserChosen == true ? "☑" : "☐") @answer.Content@(answer.IsCorrect ? " (đáp án đúng)" : "")
                    </li>
                }
            </ul>
            @if (!string.IsNullOrWhiteSpace(question.Explain))
            {
                <div class="explain">@question.Explain</div>
            }
        </AppCard>
    }

    <AppButton Variant="AppButtonVariant.OutlineAccent" OnClick="GoToHistory">Xem lịch sử làm bài</AppButton>
}
