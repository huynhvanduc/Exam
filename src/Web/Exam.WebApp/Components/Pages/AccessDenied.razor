@page "/access-denied"
@using Exam.WebApp.Extensions
@inject NavigationManager Navigation

<PageTitle>Không có quyền truy cập</PageTitle>

<InfoMessagePage Icon="🔒"
                 Title="Bạn không có quyền truy cập trang này"
                 Message="Tài khoản của bạn không đủ quyền để xem nội dung này. Nếu bạn cho rằng đây là nhầm lẫn, hãy liên hệ quản trị viên.">
    <AuthorizeView>
        <Authorized>
            <a class="btn primary" href="@context.User.GetDefaultLandingPath()">Về trang của tôi</a>
        </Authorized>
        <NotAuthorized>
            <AppButton Variant="AppButtonVariant.Primary" OnClick="GoToLogin">
                Đăng nhập
            </AppButton>
        </NotAuthorized>
    </AuthorizeView>
</InfoMessagePage>

@code {
    private void GoToLogin() => Navigation.GoToLogin();
}
