@page "/exams/take/{AttemptId}"
@attribute [Authorize]
@inherits PageBase

<PageTitle>Làm bài thi</PageTitle>

@if (attempt == null)
{
    <AppSpinner />
}
else
{
    var question = questions[currentIndex];
    var isLast = currentIndex == questions.Count - 1;
    var isMultiple = question.QuestionType != QuestionType.SingleSelection;

    <div class="exam-frame">
        <div class="exam-topbar">
            <div class="exam-title">@attempt.ExamTitle</div>
            <div class="spacer"></div>
            <div class="progress-pill">Đã trả lời <b>@AnsweredCount</b>/<b>@questions.Count</b></div>
            @if (remaining.HasValue)
            {
                <div class="timer @(remaining.Value.TotalMinutes < 5 ? "critical" : "")">@FormatRemaining(remaining.Value)</div>
            }
            <AppButton Variant="AppButtonVariant.Primary" OnClick="OpenSubmitModal">Nộp bài</AppButton>
        </div>

        <div class="exam-body">
            <main class="reading-pane">
                <div class="q-eyebrow">
                    <span class="q-index">CÂU @((currentIndex + 1).ToString("D2")) / @questions.Count</span>
                    <span class="q-type">@(isMultiple ? "Nhiều đáp án" : "Một đáp án")</span>
                </div>
                <p class="q-content">@question.Content</p>
                <div class="options">
                    @foreach (var answer in question.Answers)
                    {
                        var selected = IsSelected(question.Id, answer.Id);
                        <div class="option @(selected ? "selected" : "")" data-shape="@(isMultiple ? "checkbox" : "radio")"
                             @onclick="() => OnAnswerClicked(question, answer.Id)">
                            <span class="mark"></span><span>@answer.Content</span>
                        </div>
                    }
                </div>
                <p class="hint">@(isMultiple ? "Chọn tất cả đáp án đúng." : "Chọn một đáp án đúng nhất.")</p>
            </main>

            <aside class="navigator @(navigatorOpen ? "sheet-open" : "")">
                <div>
                    <div class="nav-label2">Danh sách câu hỏi</div>
                    <div class="palette">
                        @for (var i = 0; i < questions.Count; i++)
                        {
                            var idx = i;
                            var q = questions[idx];
                            <button type="button"
                                    class="pcell @(IsAnswered(q.Id) ? "answered" : "") @(marked.Contains(q.Id) ? "marked" : "") @(idx == currentIndex ? "current" : "")"
                                    @onclick="() => GoTo(idx)">
                                @(idx + 1)
                            </button>
                        }
                    </div>
                </div>
                <div class="legend">
                    <div class="legend-row"><span class="swatch current"></span> Câu đang xem</div>
                    <div class="legend-row"><span class="swatch answered"></span> Đã trả lời</div>
                    <div class="legend-row"><span class="swatch marked"></span> Đánh dấu xem lại</div>
                    <div class="legend-row"><span class="swatch unanswered"></span> Chưa trả lời</div>
                </div>
            </aside>
        </div>

        <div class="mobile-fab" @onclick="() => navigatorOpen = !navigatorOpen">📋 Danh sách câu hỏi — xem tiến độ</div>

        <div class="exam-actionbar">
            <AppButton Disabled="currentIndex == 0" OnClick="() => GoTo(currentIndex - 1)">← Câu trước</AppButton>
            <AppButton Variant="@(marked.Contains(question.Id) ? AppButtonVariant.OutlineAccent : AppButtonVariant.Default)"
                       OnClick="() => ToggleMark(question.Id)">
                @(marked.Contains(question.Id) ? "🚩 Đã đánh dấu — bỏ đánh dấu" : "🚩 Đánh dấu để xem lại")
            </AppButton>
            <div class="spacer"></div>
            <AppButton Variant="AppButtonVariant.Primary" OnClick="OnNextClicked">
                @(isLast ? "Xem lại trước khi nộp →" : "Câu tiếp →")
            </AppButton>
        </div>
    </div>

    @if (showSubmitModal)
    {
        <div class="modal-overlay open">
            <div class="modal">
                <h2>Xác nhận nộp bài</h2>
                <p class="desc">Bạn không thể chỉnh sửa câu trả lời sau khi nộp bài. Kiểm tra lại trước khi xác nhận.</p>
                <div class="summary-row"><span>Đã trả lời</span><b>@AnsweredCount/@questions.Count</b></div>
                <div class="summary-row">
                    <div><div>Chưa trả lời</div><div class="qlist">@UnansweredListText()</div></div>
                    <b>@UnansweredCount()</b>
                </div>
                <div class="summary-row">
                    <div><div>Đã đánh dấu xem lại</div><div class="qlist">@MarkedListText()</div></div>
                    <b>@marked.Count</b>
                </div>
                <div class="modal-actions">
                    <AppButton OnClick="() => showSubmitModal = false">Tiếp tục làm bài</AppButton>
                    <AppButton Variant="AppButtonVariant.Primary" OnClick="SubmitAsync">Nộp bài</AppButton>
                </div>
            </div>
        </div>
    }
}
