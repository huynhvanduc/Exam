@page "/my-classes"
@attribute [Authorize]
@inherits PageBase

<PageTitle>Lớp của tôi</PageTitle>

<h1 class="page-title">Lớp của tôi</h1>

<AppCard Class="join-card">
    <div style="font-weight:700;font-size:14.5px;margin-bottom:10px;">Tham gia lớp mới</div>
    <div class="join-row">
        <input placeholder="Mã lớp" @bind="joinCode" @bind:event="oninput" />
        <AppButton Variant="AppButtonVariant.Primary" OnClick="JoinAsync" Disabled="string.IsNullOrWhiteSpace(joinCode)">
            Tham gia
        </AppButton>
    </div>
</AppCard>

@if (classes == null)
{
    <AppSpinner />
}
else if (classes.Count == 0)
{
    <div class="empty-state">Bạn chưa tham gia lớp nào. Nhập mã lớp do giáo viên cung cấp để bắt đầu.</div>
}
else
{
    <div class="grid cols-3">
        @foreach (var classRoom in classes)
        {
            <AppCard Class="class-card">
                <h2>@classRoom.Name</h2>
                <div class="sub">@classRoom.MemberCount thành viên</div>
            </AppCard>
        }
    </div>
}
