@page "/my-classes"
@page "/my-classes/{Id}"
@attribute [Authorize]
@inherits PageBase
@inject NavigationManager Navigation

<PageTitle>Lớp của tôi</PageTitle>

<h1 class="page-title">Lớp của tôi</h1>
<p class="page-sub">Chọn 1 lớp bên trái để xem thành viên cùng lớp và mã tham gia.</p>

<div class="master-detail">
    <aside class="md-list">
        <div class="md-list-items">
            @if (classes == null)
            {
                <AppSpinner />
            }
            else if (classes.Count == 0)
            {
                <div class="empty-state">Bạn chưa tham gia lớp nào. Nhập mã lớp do giáo viên cung cấp để bắt đầu.</div>
            }
            else
            {
                @foreach (var c in classes)
                {
                    <div class="md-item @(c.Id == selected?.Id ? "active" : "")" @onclick="() => SelectClass(c.Id)">
                        <div class="t">@c.Name</div>
                        <div class="m">@c.MemberCount thành viên</div>
                    </div>
                }
            }
        </div>
        <div class="md-list-footer">
            <div class="join-row">
                <input placeholder="Mã lớp" @bind="joinCode" @bind:event="oninput" />
                <AppButton Variant="AppButtonVariant.Primary" OnClick="JoinAsync" Disabled="string.IsNullOrWhiteSpace(joinCode)">
                    Tham gia
                </AppButton>
            </div>
        </div>
    </aside>
    <section class="md-detail">
        @if (selected == null)
        {
            <div class="md-empty"><div class="big">🏫</div>Chọn một lớp bên trái để xem chi tiết</div>
        }
        else
        {
            <h2 style="font-size:18px;margin:0 0 14px;">@selected.Name</h2>
            <div class="grid2">
                <AppCard>
                    <h3>Thông tin chung</h3>
                    <div style="font-size:12px;color:var(--ink-soft);">Mã lớp (dùng để mời bạn học khác tham gia):</div>
                    <div class="join-code-display">@selected.JoinCode</div>
                </AppCard>
                <AppCard>
                    <h3>Thành viên (@selected.Members.Count)</h3>
                    @if (selected.Members.Count == 0)
                    {
                        <div class="empty-state">Chưa có học viên nào khác trong lớp này.</div>
                    }
                    else
                    {
                        @foreach (var member in selected.Members)
                        {
                            <div class="member-row">
                                <span>@member.FullName (@member.Email)</span>
                            </div>
                        }
                    }
                </AppCard>
            </div>
        }
    </section>
</div>
