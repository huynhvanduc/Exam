@page "/my-history"
@attribute [Authorize]
@inherits PageBase

<PageTitle>Lịch sử làm bài</PageTitle>

<h1 class="page-title">Lịch sử làm bài</h1>
<p class="page-sub">Toàn bộ lượt làm bài của bạn, mới nhất trước.</p>

<AppCard>
    <AppTable TItem="ExamResultSummaryDto" @ref="table" ServerData="LoadServerData" ColumnCount="6"
              EmptyText="Bạn chưa làm bài thi nào.">
        <HeaderContent>
            <th>Đề thi</th>
            <th>Điểm</th>
            <th>Kết quả</th>
            <th>Bắt đầu</th>
            <th>Trạng thái</th>
            <th></th>
        </HeaderContent>
        <RowTemplate Context="row">
            <tr>
                <td>@row.ExamTitle</td>
                <td>@row.TotalScore/@row.MaxPossibleScore</td>
                <td>
                    @if (row.Passed.HasValue)
                    {
                        <AppChip Variant="@(row.Passed.Value ? AppChipVariant.Success : AppChipVariant.Danger)">
                            @(row.Passed.Value ? "Đạt" : "Không đạt")
                        </AppChip>
                    }
                    else
                    {
                        @:—
                    }
                </td>
                <td>@row.ExamStartDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(row.Finished ? "Đã nộp" : "Đang làm")</td>
                <td>
                    @if (row.Finished)
                    {
                        <AppButton OnClick="() => GoToResult(row.Id)">Xem</AppButton>
                    }
                    else
                    {
                        <AppButton Variant="AppButtonVariant.Primary" OnClick="() => GoToTake(row.Id)">Tiếp tục</AppButton>
                    }
                </td>
            </tr>
        </RowTemplate>
    </AppTable>
</AppCard>
