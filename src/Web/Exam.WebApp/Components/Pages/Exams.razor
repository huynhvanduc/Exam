@page "/exams"
@attribute [Authorize]
@inherits PageBase
@inject NavigationManager Navigation

<PageTitle>Đề thi</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Đề thi khả dụng</MudText>

@if (exams == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (exams.Count == 0)
{
    <MudAlert Severity="Severity.Info">Hiện chưa có đề thi nào khả dụng.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var exam in exams)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6">@exam.Name</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">@exam.ShortDesc</MudText>
                    <MudText Typo="Typo.body2"><b>Số câu hỏi:</b> @exam.NumberOfQuestions</MudText>
                    <MudText Typo="Typo.body2"><b>Điểm đạt:</b> @exam.MinimumPassingScore</MudText>
                    @if (exam.IsTimeRestricted)
                    {
                        <MudText Typo="Typo.body2"><b>Thời gian:</b> @exam.Duration.TotalMinutes phút</MudText>
                    }

                    @{ var attempt = myAttempts.GetValueOrDefault(exam.Id); }
                    @if (attempt == null)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" FullWidth="true"
                                   OnClick="() => StartAsync(exam.Id)" Disabled="startingExamId == exam.Id">
                            Bắt đầu làm bài
                        </MudButton>
                    }
                    else if (!attempt.Finished)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3 mb-2">Bạn đang làm dở đề này.</MudAlert>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="@($"/exams/take/{attempt.Id}")">
                            Tiếp tục làm bài
                        </MudButton>
                    }
                    else
                    {
                        <MudAlert Severity="@(attempt.Passed == true ? Severity.Success : Severity.Warning)" Dense="true" Class="mt-3 mb-2">
                            Đã làm — @attempt.TotalScore/@attempt.MaxPossibleScore điểm (@(attempt.Passed == true ? "Đạt" : "Không đạt"))
                        </MudAlert>
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Href="@($"/exams/result/{attempt.Id}")">Xem kết quả</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                       OnClick="() => StartAsync(exam.Id)" Disabled="startingExamId == exam.Id">
                                Làm lại
                            </MudButton>
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
