@page "/exams"
@attribute [Authorize]
@inherits PageBase
@inject NavigationManager Navigation

<PageTitle>Đề thi</PageTitle>

<h1 class="page-title">Đề thi khả dụng</h1>

@if (exams == null)
{
    <AppSpinner />
}
else if (exams.Count == 0)
{
    <AppAlert Severity="AppAlertSeverity.Info">Hiện chưa có đề thi nào khả dụng.</AppAlert>
}
else
{
    <div class="grid cols-3">
        @foreach (var exam in exams)
        {
            <AppCard Class="exam-card">
                <h2>@exam.Name</h2>
                <p class="desc">@exam.ShortDesc</p>
                <div class="meta"><b>Số câu hỏi:</b> @exam.NumberOfQuestions</div>
                @if (exam.MinimumPassingScore > 0)
                {
                    <div class="meta"><b>Điểm đạt:</b> @exam.MinimumPassingScore</div>
                }
                @if (exam.IsTimeRestricted)
                {
                    <div class="meta"><b>Thời gian:</b> @exam.Duration.TotalMinutes phút</div>
                }
                @if (exam.MaxAttempts.HasValue)
                {
                    <div class="meta"><b>Số lần thi tối đa:</b> @exam.MaxAttempts lần</div>
                }

                @{ var attempt = myAttempts.GetValueOrDefault(exam.Id); }
                <div class="actions">
                    @if (attempt == null)
                    {
                        <AppButton Variant="AppButtonVariant.Primary" FullWidth="true"
                                   OnClick="() => StartAsync(exam.Id)" Disabled="startingExamId == exam.Id">
                            Bắt đầu làm bài
                        </AppButton>
                    }
                    else if (!attempt.Finished)
                    {
                        <AppAlert Severity="AppAlertSeverity.Info">Bạn đang làm dở đề này.</AppAlert>
                        <AppButton Variant="AppButtonVariant.Primary" FullWidth="true"
                                   OnClick="() => GoToTake(attempt.Id)">
                            Tiếp tục làm bài
                        </AppButton>
                    }
                    else
                    {
                        <AppAlert Severity="@(attempt.Passed == true ? AppAlertSeverity.Success : AppAlertSeverity.Warning)">
                            Đã làm — @attempt.TotalScore/@attempt.MaxPossibleScore điểm (@(attempt.Passed == true ? "Đạt" : "Không đạt"))
                        </AppAlert>
                        @if (exam.MaxAttempts.HasValue)
                        {
                            <div class="attempts-caption">Đã dùng @myAttemptCounts.GetValueOrDefault(exam.Id)/@exam.MaxAttempts lượt thi.</div>
                        }
                        <div class="row">
                            <AppButton Variant="AppButtonVariant.OutlineAccent"
                                       OnClick="() => GoToResult(attempt.Id)">
                                Xem kết quả
                            </AppButton>
                            @if (!HasReachedAttemptLimit(exam))
                            {
                                <AppButton Variant="AppButtonVariant.Primary"
                                           OnClick="() => StartAsync(exam.Id)" Disabled="startingExamId == exam.Id">
                                    Làm lại
                                </AppButton>
                            }
                        </div>
                    }
                </div>
            </AppCard>
        }
    </div>
}
