@inherits LayoutComponentBase
@inject NavigationManager Navigation

    <div class="app-topbar">
        <button class="sidebar-toggle" id="__sidebarToggle" type="button">☰</button>
        <div class="brand">Exam Platform</div>
        <div class="spacer"></div>
        <AuthorizeView>
            <Authorized>
                <div class="user-menu">
                    <div class="user-avatar">@Initials(context.User.Identity?.Name)</div>
                    <span>@context.User.Identity?.Name</span>
                </div>
                <button type="button" class="logout-btn" @onclick="GoToChangePassword">Đổi mật khẩu</button>
                <form action="/account/logout" method="post" data-enhance="false">
                    <button type="submit" class="logout-btn">Đăng xuất</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <button class="btn primary" @onclick="GoToLogin">Đăng nhập</button>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    <div class="app-sidebar" id="__sidebar">
        <AuthorizeView>
            <Authorized>
                <div class="nav-label">Thi cử</div>
                <NavLink class="nav-link" ActiveClass="active" href="/exams" Match="NavLinkMatch.Prefix"><span class="ic">📝</span>Làm bài thi</NavLink>
                <NavLink class="nav-link" ActiveClass="active" href="/my-history" Match="NavLinkMatch.Prefix"><span class="ic">🕘</span>Lịch sử làm bài</NavLink>
                <NavLink class="nav-link" ActiveClass="active" href="/my-classes" Match="NavLinkMatch.Prefix"><span class="ic">👥</span>Lớp của tôi</NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <NavLink class="nav-link" ActiveClass="active" href="/admin/dashboard" Match="NavLinkMatch.Prefix"><span class="ic">📊</span>Tổng quan</NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Instructor,Admin">
            <Authorized>
                <div class="nav-label">Nội dung</div>
                <NavLink class="nav-link" ActiveClass="active" href="/admin/categories" Match="NavLinkMatch.Prefix"><span class="ic">📚</span>Môn học</NavLink>
                <NavLink class="nav-link" ActiveClass="active" href="/admin/questions" Match="NavLinkMatch.Prefix"><span class="ic">❓</span>Ngân hàng câu hỏi</NavLink>
                <NavLink class="nav-link" ActiveClass="active" href="/admin/exams" Match="NavLinkMatch.Prefix"><span class="ic">📄</span>Đề thi</NavLink>
                <NavLink class="nav-link" ActiveClass="active" href="/admin/classes" Match="NavLinkMatch.Prefix"><span class="ic">🏫</span>Lớp học</NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-label">Quản trị</div>
                <NavLink class="nav-link" ActiveClass="active" href="/admin/permissions" Match="NavLinkMatch.Prefix"><span class="ic">🔐</span>Phân quyền</NavLink>
                <NavLink class="nav-link" ActiveClass="active" href="/admin/users" Match="NavLinkMatch.Prefix"><span class="ic">🧑‍🤝‍🧑</span>Người dùng</NavLink>
                <NavLink class="nav-link" ActiveClass="active" href="/admin/audit-log" Match="NavLinkMatch.Prefix"><span class="ic">🗂</span>Nhật ký</NavLink>
            </Authorized>
        </AuthorizeView>
    </div>

    <main class="app-main"><div class="app-main-inner">
        @Body
    </div></main>

<AppDialogHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
