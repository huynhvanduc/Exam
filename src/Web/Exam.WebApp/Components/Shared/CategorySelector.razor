<AppSelect TValue="string" Value="Value" ValueChanged="ValueChanged" Class="select" Disabled="Categories == null">
    @if (Categories != null)
    {
        @foreach (var category in Categories)
        {
            <option value="@category.Id">@category.Name</option>
        }
    }
</AppSelect>

@code {
    [Parameter, EditorRequired] public IReadOnlyCollection<CategoryDto>? Categories { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
}
