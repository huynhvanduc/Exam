# Sao chép file này thành `.env` (cùng thư mục) rồi điền giá trị thật trước khi chạy `docker compose up`.
# `.env` đã bị .gitignore loại trừ (pattern *.env) - không commit giá trị thật vào git.
#
# Chạy local không qua Docker (dotnet run) thì các secret bên dưới KHÔNG đọc từ file này, mà đọc từ
# .NET User Secrets - xem scripts/setup-local-secrets.ps1 để tự sinh + đồng bộ cả .env lẫn User Secrets
# cùng lúc (đảm bảo Identity.Server và Exam.API dùng đúng cùng 1 giá trị cho client_credentials).

SQL_SA_PASSWORD=change-me

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me

# 3 client_credentials secrets của Identity.Server (đăng ký trong appsettings.json phần IdentityServer:Clients).
# IDENTITY_INTERNAL_CLIENT_SECRET phải KHỚP giữa Identity.Server (client exam.api.internal) và Exam.API
# (IdentityServer:InternalClientSecret) - 2 bên xác thực nhau bằng đúng chuỗi này.
IDENTITY_INTERNAL_CLIENT_SECRET=change-me
IDENTITY_WAREHOUSE_CLIENT_SECRET=change-me
IDENTITY_TESTER_CLIENT_SECRET=change-me
