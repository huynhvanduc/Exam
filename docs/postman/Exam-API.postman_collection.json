{
  "info": {
    "_postman_id": "c3a1e9d0-1a2b-4c3d-9e8f-1234567890ab",
    "name": "Exam API",
    "description": "Collection test cho Exam Platform API (Category/Question/Exam/ExamAttempts). Xem docs/TESTING_GUIDE.md để biết chi tiết setup, mapping enum và known issues.\n\nChạy folder '00 - Auth' trước tiên để lấy token (tự lưu vào biến môi trường `token`), sau đó các folder khác sẽ tự dùng token này qua Bearer Auth kế thừa ở mức Collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "00 - Auth",
      "item": [
        {
          "name": "Get Token (exam.tester - read+write)",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Has access_token', () => pm.expect(body).to.have.property('access_token'));",
                  "if (body.access_token) { pm.environment.set('token', body.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "client_secret", "value": "{{clientSecret}}", "type": "text" },
                { "key": "scope", "value": "exam_api.read exam_api.write", "type": "text" }
              ]
            },
            "url": "{{identityUrl}}/connect/token"
          }
        },
        {
          "name": "Get Token (read-only worker - optional)",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.access_token) { pm.environment.set('readonlyToken', body.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "client_id", "value": "{{readonlyClientId}}", "type": "text" },
                { "key": "client_secret", "value": "{{readonlyClientSecret}}", "type": "text" },
                { "key": "scope", "value": "exam_api.read", "type": "text" }
              ]
            },
            "url": "{{identityUrl}}/connect/token"
          }
        },
        {
          "name": "[Negative] GET Categories WITHOUT token (expect 401)",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 - unauthenticated request rejected', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories"
          }
        }
      ]
